# jextract argument file: the C symbols to generate bindings for, from the
# Stable ABI at the 3.12 level. Generates com.example.ffm.python.capi.stable312
# (task jextractStable312).
#
# Python.h is extracted with Py_LIMITED_API set (see build.gradle.kts), so only
# Stable ABI symbols are visible here: those keep working with any later 3.x
# libpython. To find more, dump everything on offer and copy the lines you need:
#   jextract -D Py_LIMITED_API=0x030C0000 -I <python include dir> \
#       --dump-includes all.symbols '<Python.h>'
#
# Symbols outside that view (e.g. PyMem_RawFree, Limited API only from 3.13) are
# skipped silently, so check the generated code after adding lines here.
#
# Function-like macros are not extracted: e.g. Py_DECREF(o) is a macro, so bind
# the function Py_DecRef instead.

# <Python.h>
--include-function Py_SetProgramName
--include-function Py_InitializeEx
--include-function Py_IsInitialized
--include-function Py_FinalizeEx
--include-var Py_Version
# Diagnostics: the path configuration (wchar_t *) ...
--include-function Py_GetProgramName
--include-function Py_GetProgramFullPath
--include-function Py_GetPythonHome
--include-function Py_GetPrefix
--include-function Py_GetExecPrefix
--include-function Py_GetPath
# ... and the build (const char *).
--include-function Py_GetVersion
--include-function Py_GetPlatform
--include-function Py_GetCompiler
--include-function Py_GetBuildInfo
--include-function PyImport_AddModule
--include-function PyModule_GetDict
--include-function Py_CompileString
--include-constant Py_file_input
--include-function PyEval_EvalCode
--include-function PyErr_Print
--include-function Py_IncRef
--include-function Py_DecRef

# Thread states and the GIL: attaching threads, and sub-interpreters.
--include-function PyEval_SaveThread
--include-function PyEval_RestoreThread
--include-function PyGILState_Ensure
--include-function PyGILState_Release
--include-function PyThreadState_Get
--include-function PyThreadState_Swap
--include-function Py_NewInterpreter
--include-function Py_EndInterpreter

# Interpreter diagnostics.
--include-function PyInterpreterState_Get
--include-function PyInterpreterState_GetID
--include-function PyInterpreterState_GetDict
--include-function PyThreadState_GetID
--include-function PyThreadState_GetInterpreter
--include-function PyDict_Size

# Reading str and list objects (e.g. PyConfig_Get's results).
# (Type objects themselves, e.g. PyUnicode_Type, are exported data whose type is
# opaque in the Limited API, so jextract cannot bind them: PyObject.Type looks
# their addresses up instead.)
--include-function PyObject_Type
--include-function PyType_GetFlags
--include-function PyUnicode_AsUTF8AndSize
--include-function PyList_Size
--include-function PyList_GetItem
